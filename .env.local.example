# CookDrop — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs

# Supabase — trouvez ces valeurs dans Settings > API de votre projet
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# URL de base de l'application (pour les JSON-LD et les métadonnées OG)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
